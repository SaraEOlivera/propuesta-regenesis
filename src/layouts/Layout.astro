---
// src/layouts/Layout.astro
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import "../styles/tailwind.css";
import { nav } from "../lib/nav";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** Evita que buscadores indexen la página (ej. 404). */
  noindex?: boolean;
  /** Imagen social absoluta. Si se omite, se usa la imagen institucional. */
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  ogType?: "website" | "article";
  /** Datos estructurados adicionales (Event, FAQPage, BreadcrumbList, etc.). */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  image,
  imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  imageType = "image/jpeg",
  ogType = "website",
  structuredData,
} = Astro.props;

const defaultTitle = nav.brand.name;
const defaultDescription =
  "Regénesis es una asociación civil de Rosario que acompaña a personas que atraviesan situaciones de consumo problemático y a sus familias.";

const pageTitle = title ?? defaultTitle;
const pageDescription = description ?? defaultDescription;

const siteURL = Astro.site ?? new URL(Astro.url.origin);
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const canonicalPath =
  basePath && currentPath !== basePath && !currentPath.startsWith(`${basePath}/`)
    ? `${basePath}${currentPath.startsWith("/") ? currentPath : `/${currentPath}`}`
    : currentPath;
const canonicalURL = new URL(canonicalPath, siteURL);
const defaultOgImage = new URL(withBase("/og-image.jpg"), siteURL).href;
const ogImage = image ?? defaultOgImage;
const ogImageAlt = imageAlt ?? "Comunidad de Regénesis en un encuentro";
const structuredDataList = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];

const organization = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: nav.brand.name,
  url: new URL(withBase("/"), siteURL).href,
  logo: new URL(withBase("/apple-touch-icon.png"), siteURL).href,
  image: ogImage,
  description: defaultDescription,
  email: nav.contact.email,
  telephone: nav.contact.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: nav.contact.addressLine1,
    addressLocality: "Rosario",
    addressRegion: "Santa Fe",
    addressCountry: "AR",
  },
  sameAs: nav.social.map((social) => social.href),
};
---

<!doctype html>
<html lang="es-AR">
  <head>
    <!-- Metadatos obligatorios -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta id="theme-color-meta" name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        const KEY = "regenesis-theme";
        let mode = "auto";
        try {
          const saved = localStorage.getItem(KEY);
          if (saved === "auto" || saved === "light" || saved === "dark") {
            mode = saved;
          }
        } catch {
          // localStorage can be unavailable in private contexts
        }
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const resolved = mode === "auto" ? (systemDark ? "dark" : "light") : mode;
        const root = document.documentElement;
        root.dataset.theme = resolved;
        root.dataset.themeMode = mode;
        root.style.colorScheme = resolved;
        const themeColor = document.getElementById("theme-color-meta");
        if (themeColor) {
          themeColor.setAttribute("content", resolved === "dark" ? "#0f172a" : "#ffffff");
        }
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph y redes sociales -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={nav.brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />

    <!-- Datos estructurados de la organización -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)}></script>
    {structuredDataList.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)}></script>
    ))}
  </head>
  <body class="flex min-h-dvh flex-col bg-theme-surface-muted text-theme-text-primary antialiased selection:bg-theme-primary-lighter/50 selection:text-theme-primary-darker">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-full focus:bg-theme-surface focus:px-5 focus:py-2 focus:font-semibold focus:text-theme-primary focus:shadow-lg"
    >
      Saltar al contenido
    </a>
    <Nav />
    <main id="contenido" class="grow scroll-mt-24" tabindex="-1">
      <!-- Aquí se inyecta el contenido de cada página -->
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
