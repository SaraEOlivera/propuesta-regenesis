---
import type { ButtonVariant, ButtonSize } from "../types/design-system";
import type { IconName } from "../types/icons";
import Icon from "./Icon.astro";
import { isExternalHref, withBase } from "../lib/url";

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  ariaLabel?: string;
  class?: string;
  showIcon?: boolean;
  /** Icono opcional. Si se indica, reemplaza a la flecha de `showIcon`. */
  icon?: IconName;
  iconPosition?: "left" | "right";
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
}

const {
  variant = "primary",
  size = "base",
  href,
  ariaLabel,
  class: className = "",
  showIcon = false,
  icon,
  iconPosition = "right",
  target,
  rel,
  type = "button",
  disabled = false,
} = Astro.props;

const baseClass = "button";
const sizeClass = size === "lg" ? "button-lg" : "";
const variantClass = `button-${variant}`;
const buttonClasses = `${baseClass} ${sizeClass} ${variantClass} group ${className}`.trim();

const esExterno = isExternalHref(href);
const linkTarget = target ?? (esExterno ? "_blank" : undefined);
const linkRel = rel ?? (esExterno ? "noopener noreferrer" : undefined);

const iconoIzquierda = icon && iconPosition === "left" ? icon : undefined;
const iconoDerecha = icon && iconPosition !== "left" ? icon : showIcon ? "arrow-right" : undefined;
const iconoDerechaConMovimiento = iconoDerecha === "arrow-right";
---

{href ? (
  <a
    href={withBase(href)}
    class={buttonClasses}
    aria-label={ariaLabel}
    target={linkTarget}
    rel={linkRel}
  >
    {iconoIzquierda && <Icon name={iconoIzquierda} size="sm" class="mr-2" />}
    <slot />
    {iconoDerecha && (
      <Icon
        name={iconoDerecha}
        size="sm"
        class:list={[
          "ml-2",
          iconoDerechaConMovimiento &&
            "group-hover:translate-x-1 transition-transform duration-300",
        ]}
      />
    )}
    {esExterno && !ariaLabel && <span class="sr-only"> (se abre en una nueva pestaña)</span>}
  </a>
) : (
  <button type={type} class={buttonClasses} aria-label={ariaLabel} disabled={disabled}>
    {iconoIzquierda && <Icon name={iconoIzquierda} size="sm" class="mr-2" />}
    <slot />
    {iconoDerecha && (
      <Icon
        name={iconoDerecha}
        size="sm"
        class:list={[
          "ml-2",
          iconoDerechaConMovimiento &&
            "group-hover:translate-x-1 transition-transform duration-300",
        ]}
      />
    )}
  </button>
)}
