---
import AcompaniamientoImg from "../assets/acompaniamiento.jpg";
import biopsicosocial from "../assets/biopsico.jpg";
import vidaComunidad from "../assets/vidacomunidad.jpg";
import Card from "./Card.astro";

const services = [
  {
    title: "Acompañamiento integral",
    summary: "Contención, tratamiento y herramientas para personas que atraviesan problemáticas de consumo",
    image: AcompaniamientoImg,
    link: "/careers",
  },
  {
    title: "Mirada biopsicosocial y espiritual",
    summary: "Trabajamos la persona en su totalidad: cuerpo, mente, vínculos y espíritu.",
    image: biopsicosocial,
    link: "/careers",
  },
  {
    title: "Vida y comunidad",
    summary: "Promovemos vínculos saludables, responsabilidad y proyectos de vida significativos.",
    image: vidaComunidad,
    link: "/careers",
  },
];
---

<div class="container">
  <div class="text-center mb-12">
    <!-- <p class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4">
      
    </p> -->
    <h2>¿Qué hacemos en Regénesis?</h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
    {
      services.map((service) => (
        <Card
          title={service.title}
          summary={service.summary}
          image={service.image}
          link={service.link}
        />
      ))
    }
  </div>
</div>
