---
// src/components/Nav.astro
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./Button.astro";
import { nav } from "../lib/nav";
import { acciones } from "../lib/acciones";
import { donacionEstado } from "../lib/donacion";
import { withBase } from "../lib/url";
import logoImage from "../assets/reg_logo.png";

// La donación se promociona en el header solo cuando hay un método activo.
const mostrarDonar = donacionEstado.hayMetodo;
const donarLabel = acciones.donar.shortLabel ?? acciones.donar.label;

const normalizePath = (path: string) => (path === "/" ? "/" : path.replace(/\/$/, ""));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname || "/";
// Astro.url.pathname incluye el base en build; lo quitamos para comparar con
// los href internos, que se guardan sin el prefijo del sitio.
const currentPath = normalizePath(
  base && (pathname === base || pathname.startsWith(`${base}/`))
    ? pathname.slice(base.length) || "/"
    : pathname,
);
const isCurrentPage = (href: string) => {
  const target = normalizePath(href);
  if (target === "/") return currentPath === "/";
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-50 border-b border-theme-border bg-theme-surface">
  <div class="container">
    <div class="flex w-full items-center justify-between py-4 lg:py-5">
      <!-- Logo -->
      <a href={withBase("/")} class="group relative z-10 flex shrink-0 items-center gap-4">
        <Image
          src={logoImage}
          alt="Logo Regénesis"
          class="h-10 w-auto rounded-lg bg-white object-contain transition-transform duration-300 group-hover:scale-[1.02]"
          width={80}
          height={80}
          loading="eager"
          decoding="async"
        />
        <div class="brand whitespace-nowrap text-2xl text-theme-primary transition-transform duration-300 group-hover:scale-[1.02] lg:text-3xl">
          {nav.brand.name}
        </div>
      </a>

      <!-- Navegación de escritorio -->
      <nav aria-label="Navegación principal" class="hidden items-center gap-1 lg:flex">
        <ul class="flex items-center gap-0.5">
          {nav.links.map((link) => (
            <li>
              <a
                class="nav-link"
                href={withBase(link.href)}
                aria-current={isCurrentPage(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
          {mostrarDonar && (
            <li>
              <a
                class="nav-link inline-flex items-center gap-1.5"
                href={withBase(acciones.donar.href)}
                aria-current={isCurrentPage(acciones.donar.href) ? "page" : undefined}
              >
                <Icon name="heart" size="sm" />
                {donarLabel}
              </a>
            </li>
          )}
        </ul>
        <!-- Llamado a la acción de escritorio -->
        <div class="ml-4 flex items-center gap-2 border-l border-theme-border pl-4">
          <ThemeToggle />
          <Button variant="primary" href={acciones.contacto.href} class="text-sm">
            {acciones.contacto.label}
          </Button>
        </div>
      </nav>

      <!-- Controles móviles -->
      <div class="flex items-center gap-1 lg:hidden">
        <ThemeToggle />
        <button
          type="button"
          data-menu-toggle
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú"
          class="rounded-lg p-2 text-theme-text-secondary transition-colors hover:bg-theme-surface-hover hover:text-theme-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-theme-primary"
        >
          <span data-menu-icon="open">
            <Icon name="menu" size="lg" />
          </span>
          <span data-menu-icon="close" class="hidden">
            <Icon name="close" size="lg" />
          </span>
        </button>
      </div>
    </div>

    <!-- Menú de navegación móvil -->
    <div id="mobile-menu" data-mobile-menu class="mobile-menu hidden lg:hidden">
      <nav
        aria-label="Navegación móvil"
        class="border-t border-theme-border bg-theme-surface shadow-md"
      >
        <div class="mx-auto max-w-md px-4 py-6">
          <ul class="mb-6 space-y-1">
            {nav.links.map((link) => (
              <li>
                <a
                  class="mobile-nav-link group flex items-center rounded-xl px-4 py-3 text-base font-medium text-theme-text-secondary transition-colors duration-200 hover:bg-theme-surface-hover hover:text-theme-primary"
                  href={withBase(link.href)}
                  aria-current={isCurrentPage(link.href) ? "page" : undefined}
                >
                  <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-theme-surface-muted transition-colors group-hover:bg-theme-surface-hover">
                    <Icon
                      name={link.icon}
                      size="md"
                      class="text-theme-text-secondary transition-colors group-hover:text-theme-primary"
                    />
                  </div>
                  <span>{link.label}</span>
                </a>
              </li>
            ))}
            {mostrarDonar && (
              <li>
                <a
                  class="mobile-nav-link group flex items-center rounded-xl px-4 py-3 text-base font-medium text-theme-text-secondary transition-colors duration-200 hover:bg-theme-surface-hover hover:text-theme-primary"
                  href={withBase(acciones.donar.href)}
                  aria-current={isCurrentPage(acciones.donar.href) ? "page" : undefined}
                >
                  <div class="mr-3 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-theme-surface-muted transition-colors group-hover:bg-theme-surface-hover">
                    <Icon
                      name="heart"
                      size="md"
                      class="text-theme-text-secondary transition-colors group-hover:text-theme-primary"
                    />
                  </div>
                  <span>{donarLabel}</span>
                </a>
              </li>
            )}
          </ul>
          <div class="mb-4 flex items-center justify-between gap-3 rounded-xl border border-theme-border px-4 py-2">
            <span class="text-sm font-medium text-theme-text-secondary">Tema</span>
            <ThemeToggle />
          </div>
          <div class="border-t border-theme-border pt-4">
            <Button
              variant="primary"
              href={acciones.contacto.href}
              class="w-full justify-center text-base"
            >
              {acciones.contacto.label}
            </Button>
          </div>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const iconOpen = toggle?.querySelector<HTMLElement>('[data-menu-icon="open"]');
  const iconClose = toggle?.querySelector<HTMLElement>('[data-menu-icon="close"]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
      menu.classList.toggle("hidden", !open);
      iconOpen?.classList.toggle("hidden", open);
      iconClose?.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      setOpen(open);
      if (open) menu.querySelector<HTMLElement>("a")?.focus();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    const desktop = window.matchMedia("(min-width: 1024px)");
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .mobile-menu {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Active link highlighting */
  .nav-link[aria-current="page"],
  .mobile-nav-link[aria-current="page"] {
    color: var(--color-theme-primary);
    background-color: var(--color-theme-surface-hover);
  }

  [data-menu-toggle] {
    border-radius: 0.5rem;
  }
</style>
