---

<svg
  class={iconClasses}
  fill="none"
  stroke="currentColor"
  viewBox={icon.viewBox}
  aria-hidden="true"
  focusable="false"
>
  {icon.paths.map((path) => (
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width={icon.strokeWidth} d={path} />
  ))}
</svg>
