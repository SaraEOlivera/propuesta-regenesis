---
import heroServicesImage from "../assets/regenesis/action.jpeg";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Heading from "./Heading.astro";

interface Props {
  heading: string;
  subheading: string;
  primaryButtonText: string;
  primaryButtonLink: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  backgroundImage?: ImageMetadata;
}

const {
  heading,
  subheading,
  primaryButtonText,
  primaryButtonLink,
  secondaryButtonText,
  secondaryButtonLink,
  backgroundImage = heroServicesImage,
} = Astro.props;
---

<section class="relative isolate overflow-hidden py-20 sm:py-24 lg:py-28">
  {/* Imagen de fondo */}
  <div class="absolute inset-0 -z-20">
    <Image
      src={backgroundImage}
      alt=""
      class="h-full w-full object-cover object-center"
      loading="lazy"
    />
  </div>

  {/* Capa de contraste para mejorar la lectura */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-[color:var(--color-theme-primary-darker)]/80 via-[color:var(--color-theme-primary-dark)]/65 to-[color:var(--color-theme-primary-dark)]/75"
    aria-hidden="true"
  ></div>

  <div class="container relative mx-auto px-4">
    <div class="narrow mx-auto max-w-3xl text-center text-white">
      <Heading level="h2" size="page" class="mb-6 text-white">
        {heading}
      </Heading>

      <p
        class="mx-auto mb-10 max-w-2xl text-lg font-light leading-relaxed text-white/95 sm:text-xl"
      >
        {subheading}
      </p>

      <div class="flex flex-col flex-wrap justify-center gap-4 sm:flex-row">
        <Button
          variant="white"
          href={primaryButtonLink}
          class="hover:scale-105 hover:shadow-2xl"
          showIcon={true}
        >
          {primaryButtonText}
        </Button>

        {
          secondaryButtonText && secondaryButtonLink && (
            <Button
              variant="white-outline"
              href={secondaryButtonLink}
              class="hover:shadow-2xl"
            >
              {secondaryButtonText}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>