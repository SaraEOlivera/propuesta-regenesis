---
import heroServicesImage from "../assets/actividades/deporte-comunidad.jpg";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import Heading from "./Heading.astro";
import { placeholderStyle } from "../lib/images";
import { acciones, type Accion } from "../lib/acciones";

interface Props {
  heading: string;
  subheading: string;
  /** Acción principal. Por defecto, contacto. */
  primaryAction?: Accion;
  /** Acción secundaria opcional (actividades, información, etc.). */
  secondaryAction?: Accion;
  backgroundImage?: ImageMetadata;
}

const {
  heading,
  subheading,
  primaryAction = acciones.contacto,
  secondaryAction,
  backgroundImage = heroServicesImage,
} = Astro.props;

const accionPrincipal: Accion = primaryAction;
const imagePlaceholder = await placeholderStyle(backgroundImage);
---

<section class="relative isolate overflow-hidden py-20 sm:py-24 lg:py-28">
  {/* Imagen de fondo */}
  <div class="absolute inset-0 -z-20">
    <Image
      src={backgroundImage}
      alt=""
      class="h-full w-full object-cover object-center"
      style={imagePlaceholder}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      quality={40}
      loading="lazy"
    />
  </div>

  {/* Capa de contraste para mejorar la lectura */}
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-r from-[color:var(--color-theme-primary-darker)]/80 via-[color:var(--color-theme-primary-dark)]/65 to-[color:var(--color-theme-primary-dark)]/75"
    aria-hidden="true"
  ></div>

  <div class="container relative">
    <div class="narrow mx-auto max-w-3xl text-center text-white">
      <Heading level="h2" align="center" class="mb-6 text-white">
        {heading}
      </Heading>

      <p class="mx-auto mb-10 max-w-2xl text-lg font-light leading-relaxed text-white/95 sm:text-xl">
        {subheading}
      </p>

      <div class="flex flex-col flex-wrap justify-center gap-4 sm:flex-row">
        <Button
          variant="white"
          href={accionPrincipal.href}
          icon={accionPrincipal.icon}
          class="hover:scale-105 hover:shadow-2xl"
          showIcon={!accionPrincipal.icon}
        >
          {accionPrincipal.label}
        </Button>

        {secondaryAction && (
          <Button variant="white-outline" href={secondaryAction.href} class="hover:shadow-2xl">
            {secondaryAction.label}
          </Button>
        )}
      </div>
    </div>
  </div>
</section>
