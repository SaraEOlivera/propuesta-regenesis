---
import Layout from "../layouts/Layout.astro";
import about from "../assets/regenesis/about.jpeg";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";

const icons = {
  heart:
    '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  sparkles:
    '<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>',
  home: '<path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  sprout:
    '<path d="M7 20h10"/><path d="M10 20c5.5-2.5.8-6.4 3-10"/><path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/><path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>',
  ear: '<path d="M6 8.5a6.5 6.5 0 1 1 13 0c0 6-6 6-6 10a3.5 3.5 0 1 1-7 0"/><path d="M15 8.5a2.5 2.5 0 0 0-5 0v1a2 2 0 1 1 0 4"/>',
  users:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
};

const pillars = [
  {
    title: "Acompañar",
    text: "Ofrecer escucha, orientación y contención, respetando la historia y los tiempos de cada persona.",
    icon: icons.heart,
    tint: "bg-rose-100 text-rose-700",
    shape: "rounded-[2.5rem_2.5rem_2.5rem_0.75rem]",
  },
  {
    title: "Promover el bienestar",
    text: "Favorecer herramientas que contribuyan al bienestar personal y a la vida cotidiana.",
    icon: icons.sparkles,
    tint: "bg-amber-100 text-amber-700",
    shape: "rounded-[2.5rem_0.75rem_2.5rem_2.5rem]",
  },
  {
    title: "Fortalecer vínculos",
    text: "Reconocer el valor de las redes afectivas, familiares y comunitarias como apoyo.",
    icon: icons.home,
    tint: "bg-sky-100 text-sky-700",
    shape: "rounded-[0.75rem_2.5rem_2.5rem_2.5rem]",
  },
  {
    title: "Construir oportunidades",
    text: "Impulsar la autonomía y la posibilidad de proyectar nuevos caminos de vida.",
    icon: icons.sprout,
    tint: "bg-emerald-100 text-emerald-700",
    shape: "rounded-[2.5rem_2.5rem_0.75rem_2.5rem]",
  },
];

const approaches = [
  {
    title: "Escucha y orientación",
    text: "Generar espacios donde las personas puedan expresar sus inquietudes y conocer opciones de acompañamiento acordes a su situación.",
    icon: icons.ear,
    tint: "bg-amber-100 text-amber-700",
  },
  {
    title: "Redes de apoyo",
    text: "Reconocer la importancia de los vínculos y del entorno comunitario en los procesos personales.",
    icon: icons.users,
    tint: "bg-sky-100 text-sky-700",
  },
];


const team: { name: string; role: string; photo: ImageMetadata }[] = [];
---

<Layout
  title="Quiénes somos | Regénesis"
  description="Conocé Regénesis, una asociación civil de Rosario comprometida con el acompañamiento de personas que atraviesan situaciones de consumo problemático."
>
  <PageHero
    title="Quiénes somos"
    description="Regénesis es una asociación civil de Rosario comprometida con el acompañamiento de personas que atraviesan situaciones de consumo problemático y adicciones. Creemos que cada persona tiene una historia única y merece ser escuchada, comprendida y acompañada sin prejuicios. Trabajamos desde una mirada humana e integral, promoviendo la contención, el bienestar y la construcción de nuevas oportunidades. Entendemos que los procesos de recuperación requieren tiempo, compromiso y apoyo, por eso valoramos la importancia de los vínculos y de contar con espacios donde cada persona pueda encontrar orientación y herramientas para avanzar hacia una vida más saludable. En Regénesis creemos que siempre es posible comenzar de nuevo."
    image={about}
  />

  <!-- Presentación -->
  <section class="section relative overflow-hidden bg-theme-surface">
    <div
      class="pointer-events-none absolute -left-24 top-8 h-72 w-72 rounded-full bg-theme-primary-lighter/40 blur-3xl"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-20 bottom-0 h-64 w-64 rounded-full bg-amber-200/40 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container relative">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-base font-semibold text-theme-primary mb-3">Regénesis</p>
        <h2 class="font-display text-4xl lg:text-5xl text-theme-text-primary mb-8 leading-tight">
          Cada historia merece nuevas oportunidades
        </h2>
        <p class="text-lg text-theme-text-secondary leading-relaxed mb-4">
          Somos una asociación civil de Rosario, Santa Fe, comprometida con el abordaje
          de las adicciones y el acompañamiento de las personas que atraviesan situaciones
          de consumo problemático.
        </p>
        <p class="text-lg text-theme-text-secondary leading-relaxed">
          Buscamos promover un espacio de escucha, orientación y contención, donde cada
          persona pueda sentirse acompañada y encontrar herramientas para transitar su
          propio proceso, con respeto por su historia y sus tiempos.
        </p>
      </div>
    </div>
  </section>

  <!-- Historia -->
  <section class="section relative overflow-hidden bg-gradient-to-b from-theme-primary-lighter/20 via-theme-primary-lighter/10 to-theme-surface">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-20 items-center">
        <div>
          <p class="text-base font-semibold text-theme-primary mb-3">Nuestra historia</p>
          <h2 class="font-display text-3xl lg:text-4xl text-theme-text-primary mb-6 leading-tight">
            Un camino que se construye en comunidad
          </h2>
          <p class="text-lg text-theme-text-secondary leading-relaxed mb-4">
            Regénesis es una asociación civil con personería jurídica en la provincia de
            Santa Fe. Desde Rosario, forma parte de los espacios comunitarios comprometidos
            con el abordaje de las adicciones.
          </p>
          <p class="text-lg text-theme-text-secondary leading-relaxed mb-4">
            Nuestro nombre representa la posibilidad de un nuevo comienzo: reconocer la
            propia historia, recuperar la confianza y abrirse a otras oportunidades.
          </p>
          <p class="text-lg text-theme-text-secondary leading-relaxed">
            La historia y el recorrido de la institución siguen creciendo a través del
            trabajo cotidiano, el compromiso y el vínculo con la comunidad.
          </p>
        </div>

        <!-- Tarjeta-cita con "hojas" inclinadas detrás -->
        <div class="relative mx-4 lg:mx-8">
          <div
            class="absolute inset-0 rotate-[5deg] rounded-[2rem] bg-amber-200/70"
            aria-hidden="true"
          >
          </div>
          <div
            class="absolute inset-0 -rotate-[3deg] rounded-[2rem] bg-theme-primary-lighter/60"
            aria-hidden="true"
          >
          </div>
          <figure class="relative rounded-[2rem] bg-theme-surface p-8 lg:p-12 shadow-lg">
            <span
              class="font-display block text-8xl leading-none text-theme-primary/30 select-none"
              aria-hidden="true">“</span
            >
            <figcaption class="font-display text-2xl text-theme-text-primary mb-4 -mt-6">
              ¿Qué nos inspira?
            </figcaption>
            <blockquote class="text-lg text-theme-text-secondary leading-relaxed">
              La convicción de que nadie debería atravesar una situación difícil en soledad
              y de que el acompañamiento, los vínculos y el acceso a orientación pueden abrir
              nuevas posibilidades.
            </blockquote>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- Onda: entrada a la sección de color -->
  <div class="bg-theme-surface text-theme-primary" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="block h-12 w-full fill-current lg:h-20">
      <path d="M0,40 C240,90 480,0 720,40 C960,80 1200,10 1440,40 L1440,80 L0,80 Z"></path>
    </svg>
  </div>

  <!-- Misión y objetivos -->
  <section class="bg-theme-primary py-16 lg:py-20 text-white">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <p class="text-base font-semibold text-white/80 mb-3">Nuestro propósito</p>
        <h2 class="font-display text-3xl lg:text-5xl mb-5 leading-tight">Misión y objetivos</h2>
        <p class="text-lg text-white/90 leading-relaxed">
          Acompañar procesos personales desde una mirada respetuosa, promoviendo el bienestar,
          los vínculos y la construcción de nuevas oportunidades.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          pillars.map((p) => (
            <article class={`bg-theme-surface p-7 shadow-md ${p.shape}`}>
              <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-full ${p.tint}`}>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  width="26"
                  height="26"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={p.icon}
                />
              </div>
              <h3 class="font-display text-xl text-theme-text-primary mb-3">{p.title}</h3>
              <p class="text-theme-text-secondary leading-relaxed">{p.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Onda: salida de la sección de color -->
  <div class="bg-theme-surface text-theme-primary" aria-hidden="true">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="block h-12 w-full fill-current lg:h-20">
      <path d="M0,0 L1440,0 L1440,40 C1200,80 960,0 720,40 C480,80 240,10 0,40 Z"></path>
    </svg>
  </div>

  <!-- Acompañamiento -->
  <section class="section relative overflow-hidden bg-gradient-to-b from-theme-primary-lighter/20 via-theme-primary-lighter/10 to-theme-surface">
    <div class="container">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <p class="text-base font-semibold text-theme-primary mb-3">Cómo acompañamos</p>
          <h2 class="font-display text-3xl lg:text-4xl text-theme-text-primary mb-5 leading-tight">
            Cada proceso es único
          </h2>
          <p class="text-lg text-theme-text-secondary leading-relaxed">
            Entendemos que cada historia es diferente. Por eso, consideramos fundamental
            escuchar sin juzgar, respetar los tiempos individuales y reconocer las necesidades
            particulares de cada persona.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            approaches.map((a, i) => (
              <div
                class={`rounded-[2rem] bg-theme-surface p-8 shadow-md ${i % 2 === 1 ? "md:mt-10" : ""}`}
              >
                <div class={`mb-5 flex h-14 w-14 items-center justify-center rounded-full ${a.tint}`}>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    width="26"
                    height="26"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={a.icon}
                  />
                </div>
                <h3 class="font-display text-xl text-theme-text-primary mb-3">{a.title}</h3>
                <p class="text-theme-text-secondary leading-relaxed">{a.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <CallToActionSection
    heading="Estamos para escucharte"
    subheading="Si necesitás orientación o querés conocer más sobre Regénesis, ponete en contacto con nosotros."
    primaryButtonText="Contactanos"
    primaryButtonLink="/contact"
    secondaryButtonText="Conocé nuestros recursos"
    secondaryButtonLink="/services"
  />
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Young+Serif&display=swap");

  .font-display {
    font-family: "Young Serif", Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: -0.01em;
  }
</style>