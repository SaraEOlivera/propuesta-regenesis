---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import imagenCentral from "../assets/main-hero.jpg";
import nombreRegenesis from "../assets/por-que-regenesis.jpg";
import mensaje from "../assets/seccion-mensaje.jpg";
import recuperarse from "../assets/recuperarse.jpg";
import ServicesIntroSection from "../components/ServicesIntroSection.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import faqs from "../data/faqs.json";
import NumberCounter from "../components/NumberCounter.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Link from "../components/Link.astro";

interface ServiceCard {
	title: string;
	description: string;
	link: string;
}

const serviceCards: ServiceCard[] = [
	{
		title: "Professional Care Services",
		description:
			"Expert care tailored to your needs in the comfort of your home",
		link: "/services#care",
	},
	{
		title: "Specialized Support",
		description: "Specialized support for complex medical conditions",
		link: "/services#specialty",
	},
	{
		title: "24/7 Support",
		description: "Round-the-clock care and support when you need it most",
		link: "/services#support",
	},
];
---

<Layout
	title="Regénesis  | Centro Integral de Adicciones"
	description="Comunidad terapéutica para el tratamiento de adicciones"
>
	<!-- Hero Section -->
	<section
		class="relative min-h-[85vh] flex items-center justify-center text-center px-4 py-12"
		role="banner"
		aria-label="Hero Section"
	>
		<div class="absolute inset-0 z-0">
			<Image
				src={imagenCentral}
				alt="Professional healthcare services"
				class="w-full h-full object-cover object-top"
				loading="eager"
				fetchpriority="high"
				width={1920}
				height={1080}
			/>
			<div
				class="absolute inset-0 bg-gradient-to-r from-black/60 to-black/35"
			>
			</div>
		</div>

		<div class="container relative z-10 flex justify-center items-center">
			<div
				class="max-w-3xl text-white text-center mx-auto flex flex-col items-center justify-center"
			>
				<!-- 1. TÍTULO PRINCIPAL (Centrado, bajado y sin saltos de línea sobrantes) -->
				<h1
					class="text-5xl md:text-7xl font-extrabold leading-tight mb-2 tracking-tight animate-fade-in"
				>
					REGENESIS
				</h1>

				<!-- 2. SUBTÍTULO (Más grande y muy pegado al título) -->
				<p
					class="text-xl md:text-2xl mb-4 text-white/60 opacity-95 leading-relaxed font-light max-w-lg"
				>
					Centro Integral en Adicciones
				</p>

				<!-- 3. BOTONES (Ubicados inmediatamente debajo del texto y centrados) -->
				<div
					class="flex flex-wrap gap-3 md:gap-4 justify-center items-center mt-2"
				>
					<Button
						variant="white"
						size="lg"
						href="/contact"
						class="hover:shadow-xl hover:scale-105"
						>Necesito ayuda</Button
					>
					<Button
						variant="primary"
						size="lg"
						href="/careers"
						class="ring-2 ring-white/20 hover:shadow-xl hover:scale-105"
						>Quiero donar</Button
					>
				</div>
			</div>
		</div>
	</section>

	<!-- About Section - Asymmetric editorial layout -->
	<section class="section bg-theme-surface">
		<div class="container">
			<div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
				<div class="order-2 lg:order-1">
					<p
						class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4"
					>
						Sobre nosotros
					</p>
					<h2 class="mb-6">¿Por qué nos llamamos Regénesis?</h2>
					<p
						class="text-theme-text-secondary text-lg leading-relaxed mb-6"
					>
					Detrás de nuestro nombre hay una convicción: toda persona tiene la 
					capacidad de reconstruir su vida y reencontrarse con aquello para lo que
					 fue creada.

					</p>

					<p
						class="text-theme-text-secondary text-lg leading-relaxed mb-6"
					>
					Regenesis significa volver al origen. Volver a empezar. Regresar al propósito.
					</p>

					<p
						class="text-theme-text-secondary text-lg leading-relaxed mb-6"
					>
					Porque más allá del dolor, de las adicciones, de las 
					heridas que dejan las experiencias difíciles, hay algo 
					que nunca se pierde del todo: una esencia valiosa, un 
					propósito que sigue esperando ser recuperado.
					</p>


					<p
						class="text-theme-text-secondary text-lg leading-relaxed mb-6"
					>
					Acompañamos a personas que atraviesan problemáticas de consumo desde 
					una mirada integral —biológica, psicológica, social y espiritual— con 
					contención, tratamiento y herramientas reales para construir una nueva 
					forma de vivir.

					</p>


					<!-- <div class="text-center md:text-left">
						<Link href="/about">Learn more about us</Link>
					</div> -->
				</div>
				<div class="order-1 lg:order-2">
					<div class="relative">
						<div class="rounded-2xl overflow-hidden shadow-xl aspect-[4/3] w-full">
							<Image
								src={nombreRegenesis}
								alt="Por que nos llamamos Regenesis"
								class="w-full h-full object-cover object-center"
								loading="lazy"
							/>
						</div>
						<!-- Decorative accent -->
						<div
							class="absolute -bottom-4 -left-4 w-24 h-24 bg-theme-primary-lighter/30 rounded-2xl -z-10"
						>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Services Section -->
	<section
		class="section bg-gradient-to-b from-theme-primary-lighter/10 via-theme-primary-lighter/5 to-theme-surface"
	>
		<ServicesIntroSection />
	</section>
	
	<!-- Mensaje de acompañamiento con imagen -->
	<section class="bg-theme-surface pt-4 pb-12 md:pt-8 md:pb-16">
		<div class="container">
			<div class="text-center mb-16">
				<h2
					class="text-3xl lg:text-4xl font-bold text-theme-text-primary mb-4"
				>
					El cambio es posible
				</h2>
				<p class="text-lg text-theme-text-secondary">
					Acompañamos tu proceso de recuperación
				</p>
			</div>

			<div
				class="mx-auto flex flex-col lg:flex-row items-center gap-16 lg:gap-20"
			>
				<!-- Oval Image Container -->
				<div class="lg:w-1/2">
					<div class="relative">
						<!-- Oval mask for the image -->
						<div
							class="aspect-[16/9] rounded-[50%] overflow-hidden shadow-2xl ring-1 ring-black/5"
						>
							<Image
								src={mensaje}
								alt="Grupo de personas en comunidad"
								class="w-full h-full object-cover sepia-[0.25] saturate-[1.15] brightness-[0.98]"
								loading="lazy"
							/>
							
						</div>
					</div>
				</div>
				<!-- Content -->
				<div class="lg:w-1/2 space-y-6">
					<div
						class="prose prose-lg max-w-none text-theme-text-secondary"
					>
						<p class="text-lg leading-relaxed">
							 En Regénesis acompañamos a cada persona de manera integral: 
							 cuerpo, mente, vínculos y espíritu. Creemos que cada día cuenta, 
							 cada historia importa. El camino de recuperación se construye paso
							  a paso, acompañado y en comunidad. Ninguna persona debería atravesar
							   esto en soledad.
						</p>
						<p class="text-lg leading-relaxed">
							Si hoy estás pasando un momento difícil, o alguien cercano lo está 
							pasando, no tenés que hacerlo solo. En Regénesis acompañamos procesos
							 de recuperación completos, con avances y retrocesos, desde el respeto, 
							 la escucha y la comunidad. Si vos 
							o alguien que conocés lo necesita, estamos para acompañar. El cambio 
							 es posible. 

						</p>
					</div>
					<div class="pt-6">
						<Link href="/contact">Comunicate con nosotros</Link>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ Section -->
	<!-- <section
		class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface"
	>
		<div class="container">
			<div class="narrow mx-auto">
				<div class="text-center mb-12">
					<p
						class="text-sm font-medium tracking-widest uppercase text-theme-primary mb-4"
					>
						FAQ
					</p>
					<h2>Common Questions</h2>
				</div>
				<FaqAccordion items={faqs.slice(0, 4)} />
				<div class="text-center mt-10">
					<Link href="/info">View all FAQs</Link>
				</div>
			</div>
		</div>
	</section> -->

	<!-- CTA Section -->
	<section class="relative py-20 lg:py-28 overflow-hidden">
		<div class="absolute inset-0">
			<Image
				src={recuperarse}
				alt="Healthcare environment"
				class="w-full h-full object-cover"
				loading="lazy"
			/>
			<div class="absolute inset-0 bg-theme-primary-darker/60"></div>
		</div>
		<div class="relative container">
			<div class="max-w-2xl mx-auto text-center text-white">
				<h2 class="mb-6 text-white/80">Recuperarse es un camino que se construye entre todos</h2>
				<!-- <p class="text-lg mb-10 text-white/80 font-primary">
					Comunicate para iniciar tu camino de recuperación.
				</p> -->
				<Button variant="white" href="/contact"> Contacto </Button>
			</div>
		</div>
	</section>
</Layout>

<style>
	.stats-circle {
		opacity: 0;
		animation: fadeInScale 0.8s ease-out forwards;
		animation-play-state: paused;
	}

	@keyframes fadeInScale {
		from {
			opacity: 0;
			transform: scale(0.8);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
</style>

<script>
	// Single IntersectionObserver for stats animation (memory efficient)
	const statsObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					const circles =
						entry.target.querySelectorAll(".stats-circle");
					circles.forEach((circle) => {
						(circle as HTMLElement).style.animationPlayState =
							"running";
					});
					statsObserver.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.2 },
	);

	function initStatsAnimation() {
		const section = document.querySelector(".stats-container");
		if (section) {
			// Reset animation state for view transitions
			const circles = section.querySelectorAll(".stats-circle");
			circles.forEach((circle) => {
				(circle as HTMLElement).style.animationPlayState = "paused";
			});
			statsObserver.observe(section);
		}
	}

	// Run on initial load and after view transitions
	initStatsAnimation();
	document.addEventListener("astro:page-load", initStatsAnimation);
</script>
