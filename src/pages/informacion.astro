---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroInformacionImage from "../assets/actividades/charla-grupo.jpg";
import escuchaImage from "../assets/actividades/charla-escucha.jpg";
import tallerImage from "../assets/actividades/taller-oficios.jpg";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Icon from "../components/Icon.astro";
import CheckListItem from "../components/CheckListItem.astro";
import Button from "../components/Button.astro";
import Heading from "../components/Heading.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { acciones } from "../lib/acciones";
import { placeholderStyle } from "../lib/images";
import { withBase } from "../lib/url";
import {
  materiales,
  paraFamilias,
  pasosParaPedirAyuda,
  senalesDeAlerta,
  sections,
  tiposDeConsumo,
} from "../data/informacion";

// El enlace se habilita solo cuando el PDF existe en public/materiales.
// Mientras no esté, la tarjeta se muestra como "Próximamente" sin enlace roto.
const materialesDisponibles = materiales.map((material) => ({
  ...material,
  disponible: existsSync(join(process.cwd(), "public", material.href.replace(/^\//, ""))),
}));

// La sección y su ancla se muestran recién cuando hay al menos un PDF publicado.
const hayMateriales = materialesDisponibles.some((material) => material.disponible);
const seccionesVisibles = sections.filter(
  (section) => section.id !== "materiales" || hayMateriales,
);

const [escuchaPlaceholder, tallerPlaceholder] = await Promise.all([
  placeholderStyle(escuchaImage),
  placeholderStyle(tallerImage),
]);
---

<Layout
  title="Información | Regénesis"
  description="Información, orientación y materiales sobre consumos problemáticos, para personas que necesitan ayuda y para sus familias."
>
  <!-- Portada -->
  <PageHero
    title="Información y orientación sobre consumos problemáticos"
    description="Información clara, materiales de orientación y acompañamiento para quienes atraviesan un consumo problemático y para sus familias. Pedir ayuda es un primer paso, y no hace falta darlo solo."
    image={heroInformacionImage}
    imageAlt="Grupo de personas de la comunidad de Regénesis en un encuentro"
  />

  <!-- Ayuda inmediata -->
  <section class="section bg-theme-surface pb-0">
    <div class="container">
      <div class="max-w-5xl mx-auto bg-theme-primary-darker rounded-2xl p-8 lg:p-10 text-white flex flex-col lg:flex-row lg:items-center gap-6">
        <Icon name="heart" size="xl" class="text-theme-primary-lighter flex-shrink-0" />
        <div class="flex-1 space-y-2">
          <Heading level="h2" size="section" class="text-white">
            ¿Necesitás hablar con alguien ahora?
          </Heading>
          <p class="text-white/90">
            La Línea 141 de la SEDRONAR brinda orientación y contención en adicciones. Es gratuita,
            anónima, funciona las 24 horas todos los días y atiende tanto a quienes consumen como a
            sus familiares y amigos. Si hay una emergencia o riesgo para la vida, llamá al 911.
          </p>
        </div>
        <Button variant="white" size="lg" href="tel:141" class="shrink-0 text-xl">
          Llamar al 141
        </Button>
      </div>

      <!-- Navegación interna -->
      <nav aria-label="Secciones de esta página" class="mt-8 max-w-5xl mx-auto">
        <ul class="flex flex-wrap justify-center gap-3">
          {seccionesVisibles.map((s) => (
            <li>
              <a
                href={`#${s.id}`}
                class="inline-block rounded-full border border-theme-border bg-theme-surface px-5 py-2 text-theme-text-secondary hover:text-theme-primary hover:border-theme-primary transition-colors"
              >
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <!-- 1. Información sobre consumos problemáticos -->
  <section
    id="informacion"
    class="section scroll-mt-24 bg-gradient-to-b from-theme-surface to-theme-surface-muted"
  >
    <div class="container">
      <SectionHeading
        align="center"
        eyebrow="Información"
        title="Qué son los consumos problemáticos"
        description="Hablamos de consumo problemático cuando el uso de una sustancia o una conducta empieza a afectar la salud, los vínculos, el estudio, el trabajo o la vida cotidiana. No depende solo de la cantidad ni de la frecuencia: importa cómo impacta en la persona y en su entorno."
        class="mb-4"
      />
      <p class="narrow mx-auto mb-12 text-center text-base lg:text-lg text-theme-text-secondary leading-relaxed">
        Es un problema de salud, no una falta de voluntad ni un defecto de carácter. Tiene
        tratamiento, y las personas pueden recuperarse a cualquier edad y en cualquier momento.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16">
        {tiposDeConsumo.map((t) => (
          <div class="card p-6 lg:p-8">
            <h3 class="text-xl font-bold text-theme-text-primary mb-3">{t.title}</h3>
            <p class="text-theme-text-secondary leading-relaxed">{t.description}</p>
          </div>
        ))}
      </div>

      <div class="max-w-4xl mx-auto bg-gradient-to-br from-theme-primary-lighter/20 to-theme-surface rounded-2xl p-6 lg:p-10 border border-theme-border">
        <Heading level="h3" size="page" class="mb-2">
          Señales de alerta
        </Heading>
        <p class="text-theme-text-secondary mb-6">
          Ninguna señal alcanza por sí sola para dar un diagnóstico, pero si reconocés varias, vale
          la pena consultar.
        </p>
        <ul class="space-y-3">
          {senalesDeAlerta.map((s) => (
            <CheckListItem>{s}</CheckListItem>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Información para personas que necesitan ayuda -->
  <section
    id="ayuda"
    class="section scroll-mt-24 bg-gradient-to-b from-theme-surface-muted to-theme-surface"
  >
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16">
        <div class="w-full order-2 lg:order-1">
          <Image
            src={escuchaImage}
            alt="Personas conversando en un espacio de escucha de Regénesis"
            class="w-full object-cover rounded-2xl shadow-xl"
            style={escuchaPlaceholder}
            widths={[480, 700, 1000, 1080]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            quality={70}
          />
        </div>
        <div class="space-y-6 order-1 lg:order-2">
          <SectionHeading title="Si necesitás ayuda" />
          <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
            Si sentís que el consumo se te fue de las manos, o que te está haciendo daño, no estás
            solo ni sola. Pedir ayuda no te compromete a nada y no te define: es una forma de
            cuidarte.
          </p>
          <ol class="space-y-5">
            {pasosParaPedirAyuda.map((p, i) => (
              <li class="flex items-start gap-4">
                <span
                  class="flex-shrink-0 w-9 h-9 rounded-full bg-theme-primary-solid text-white font-bold flex items-center justify-center"
                  aria-hidden="true"
                >
                  {i + 1}
                </span>
                <div>
                  <Heading level="h3" size="section" class="mb-1">
                    {p.title}
                  </Heading>
                  <p class="text-theme-text-secondary">{p.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="text-theme-text-secondary">
            La consulta es confidencial. Si preferís empezar por teléfono, podés llamar al{" "}
            <a href="tel:141" class="font-semibold text-theme-primary underline">
              141
            </a>{" "}
            en cualquier momento.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Información para familiares -->
  <section id="familias" class="section scroll-mt-24 bg-theme-surface">
    <div class="container">
      <SectionHeading
        align="center"
        eyebrow="Para familias"
        title="Para familiares y seres queridos"
        description="Cuando alguien cercano atraviesa un consumo problemático, toda la familia se ve afectada. Es normal sentir miedo, enojo, cansancio o culpa. Vos también podés pedir orientación y acompañamiento."
        class="mb-12"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div class="card bg-gradient-to-br from-theme-primary-lighter/20 to-theme-surface p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-theme-primary-solid flex items-center justify-center flex-shrink-0">
              <Icon name="check" size="lg" class="text-white" />
            </div>
            <h3 class="text-xl font-bold text-theme-text-primary">Qué te puede ayudar</h3>
          </div>
          <ul class="space-y-3">
            {paraFamilias.hacer.map((t) => (
              <CheckListItem>{t}</CheckListItem>
            ))}
          </ul>
        </div>

        <div class="card bg-gradient-to-br from-[color:var(--color-theme-accent-orange)]/20 to-theme-surface p-6 lg:p-8">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-12 rounded-2xl bg-[color:var(--color-theme-accent-orange)] flex items-center justify-center flex-shrink-0">
              <Icon name="star" size="lg" class="text-white" />
            </div>
            <h3 class="text-xl font-bold text-theme-text-primary">Qué conviene evitar</h3>
          </div>
          <ul class="space-y-3">
            {paraFamilias.evitar.map((t) => (
              <CheckListItem>{t}</CheckListItem>
            ))}
          </ul>
        </div>
      </div>

      <div class="mt-12 max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 items-center gap-8 lg:gap-12">
        <Image
          src={tallerImage}
          alt="Personas trabajando en el taller de oficios de Regénesis"
          class="w-full object-cover rounded-2xl shadow-xl"
          style={tallerPlaceholder}
          widths={[480, 800, 1100, 1600]}
          sizes="(min-width: 1024px) 45vw, 90vw"
          quality={70}
        />
        <div class="space-y-4">
          <Heading level="h3" size="page">
            No tenés que hacerlo solo ni sola
          </Heading>
          <p class="text-theme-text-secondary leading-relaxed">
            Llamar al 141 también es una opción si la persona todavía no quiere pedir ayuda: un
            equipo profesional te orienta sobre cómo acercarte, qué decir y a dónde acudir. Cerca
            del 40% de las consultas a la línea las hacen familiares y amigos.
          </p>
          <p class="text-theme-text-secondary leading-relaxed">
            Cuidar tu propia salud y tus tiempos no es egoísmo: es parte de poder acompañar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Materiales de orientación -->
  {hayMateriales && (
    <section
      id="materiales"
      class="section scroll-mt-24 bg-gradient-to-b from-theme-surface to-theme-surface-muted"
    >
      <div class="container">
        <SectionHeading
          align="center"
          eyebrow="Recursos"
          title="Materiales de orientación"
          description="Guías y recursos para leer, descargar y compartir."
          class="mb-12"
        />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {materialesDisponibles.map((m) => {
            const Tag = m.disponible ? "a" : "div";
            const linkAttrs = m.disponible
              ? {
                  href: withBase(m.href),
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {};

            return (
              <Tag
                {...linkAttrs}
                class:list={[
                  "group block card p-6 lg:p-8",
                  m.disponible
                    ? "card-interactive focus-visible:outline focus-visible:outline-2 focus-visible:outline-theme-primary"
                    : "opacity-80",
                ]}
              >
                <div class="mb-2 flex items-center justify-between gap-3">
                  <span class="inline-block text-sm font-semibold text-theme-primary">
                    {m.format}
                  </span>
                  {!m.disponible && (
                    <span class="rounded-full bg-theme-surface-hover px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-theme-text-muted">
                      Próximamente
                    </span>
                  )}
                </div>
                <h3
                  class:list={[
                    "text-xl font-bold text-theme-text-primary mb-2",
                    m.disponible && "group-hover:text-theme-primary",
                  ]}
                >
                  {m.title}
                </h3>
                <p class="text-theme-text-secondary leading-relaxed">{m.description}</p>
                <span
                  class:list={[
                    "inline-block mt-4 font-semibold",
                    m.disponible ? "text-theme-primary" : "text-theme-text-muted",
                  ]}
                >
                  {m.disponible ? "Descargar" : "En preparación"}
                </span>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <CallToActionSection
    heading="Estamos para escucharte"
    subheading="Si necesitás orientación o querés conocer más sobre Regénesis, ponete en contacto con nosotros."
    secondaryAction={acciones.actividades}
  />
</Layout>
