---
import Layout from "../layouts/Layout.astro";

import professionalPortraitImage from "../assets/professional-portrait.jpg";
import { Image } from "astro:assets";
import serviceDetailImage from "../assets/service-detail.jpg";
import heroServicesImage from "../assets/hero-services.jpg";
import PageHero from "../components/PageHero.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Icon from "../components/Icon.astro";
import CheckListItem from "../components/CheckListItem.astro";
import Heading from "../components/Heading.astro";
 
const sections = [
  { id: "informacion", label: "Qué son los consumos problemáticos" },
  { id: "ayuda", label: "Si necesitás ayuda" },
  { id: "familias", label: "Para familiares" },
  { id: "materiales", label: "Materiales de orientación" },
];
 
const tiposDeConsumo = [
  {
    title: "Sustancias",
    description:
      "Alcohol, tabaco, cannabis, cocaína, psicofármacos usados sin indicación médica y otras drogas.",
  },
  {
    title: "Pantallas y juegos",
    description:
      "Uso de celulares, redes y videojuegos que desplaza el estudio, el trabajo, el sueño o los vínculos.",
  },
  {
    title: "Apuestas",
    description:
      "Juego de azar y apuestas online que generan deudas, ocultamiento o angustia.",
  },
];
 
const senalesDeAlerta = [
  "Cuesta controlar cuánto o cuándo se consume",
  "El consumo ocupa cada vez más tiempo, dinero o pensamientos",
  "Se abandonan actividades, estudios o vínculos que antes importaban",
  "Aparecen malestar o ansiedad cuando no se puede consumir",
  "Se consume a pesar de sus consecuencias en la salud, la familia o el trabajo",
  "Se oculta o se minimiza lo que pasa",
];
 
const pasosParaPedirAyuda = [
  {
    title: "Hablar con alguien de confianza",
    description:
      "Contarle a una persona cercana lo que te pasa ayuda a dejar de cargarlo en soledad.",
  },
  {
    title: "Pedir orientación",
    description:
      "Podés llamar a la Línea 141 o acercarte a un centro de salud, sin compromiso y sin tener que decidir nada en ese momento.",
  },
  {
    title: "Hacer una primera consulta",
    description:
      "Un equipo profesional escucha tu situación y te propone opciones de acompañamiento acordes a lo que necesitás.",
  },
  {
    title: "Armar un plan de tratamiento",
    description:
      "No existe un único camino: puede incluir terapia, grupos de apoyo, tratamiento ambulatorio o internación, según cada caso.",
  },
];
 
const paraFamilias = {
  hacer: [
    "Hablar en un momento tranquilo, sin reproches y desde la preocupación",
    "Escuchar sin interrumpir y sin juzgar",
    "Informarte sobre el tema y pedir orientación profesional",
    "Cuidarte: tu bienestar también importa",
    "Acompañar los pasos que la persona quiera dar",
  ],
  evitar: [
    "Gritar, amenazar o dar ultimátums",
    "Etiquetar a la persona por su consumo",
    "Esperar que cambie de un día para el otro",
    "Cubrir las consecuencias o hacerte cargo de todo",
    "Sentirte culpable: el consumo problemático tiene múltiples causas",
  ],
};
 
const materiales = [
  {
    title: "Guía para entender los consumos problemáticos",
    description:
      "Conceptos básicos, señales de alerta y mitos frecuentes, en lenguaje simple.",
    href: "/materiales/guia-consumos-problematicos.pdf",
    format: "PDF",
  },
  {
    title: "Cómo acompañar a un familiar",
    description:
      "Pautas para conversar, poner límites y cuidarte durante el acompañamiento.",
    href: "/materiales/guia-para-familias.pdf",
    format: "PDF",
  },
  {
    title: "Primeros pasos para pedir ayuda",
    description:
      "Qué esperar de una primera consulta y qué opciones de tratamiento existen.",
    href: "/materiales/primeros-pasos.pdf",
    format: "PDF",
  },
  {
    title: "Consumo de menor riesgo y prevención",
    description:
      "Información para jóvenes, docentes y equipos que trabajan con adolescentes.",
    href: "/materiales/prevencion.pdf",
    format: "PDF",
  },
];
---
 
<Layout
  title="Información | Regénesis"
  description="Información, orientación y materiales sobre consumos problemáticos, para personas que necesitan ayuda y para sus familias."
>
  <!-- Hero -->
  <PageHero
    title="Información y orientación sobre consumos problemáticos"
    description="Información clara, materiales de orientación y acompañamiento para quienes atraviesan un consumo problemático y para sus familias. Pedir ayuda es un primer paso, y no hace falta darlo solo."
    image={heroServicesImage}
  />
 
  <!-- Ayuda inmediata -->
  <section class="section bg-theme-surface pb-0">
    <div class="container">
      <div
        class="max-w-5xl mx-auto bg-theme-primary-darker rounded-2xl p-8 lg:p-10 text-white flex flex-col lg:flex-row lg:items-center gap-6"
      >
        <Icon
          name="heart"
          size="xl"
          class="text-theme-primary-lighter flex-shrink-0"
        />
        <div class="flex-1 space-y-2">
          <h2 class="text-2xl font-bold">¿Necesitás hablar con alguien ahora?</h2>
          <p class="text-white/90">
            La Línea 141 de la SEDRONAR brinda orientación y contención en
            adicciones. Es gratuita, anónima, funciona las 24 horas todos los
            días y atiende tanto a quienes consumen como a sus familiares y
            amigos. Si hay una emergencia o riesgo para la vida, llamá al 911.
          </p>
        </div>
        <a
          href="tel:141"
          class="inline-flex items-center justify-center rounded-xl bg-white text-theme-primary-darker font-bold text-xl px-8 py-4 hover:bg-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Llamar al 141
        </a>
      </div>
 
      <!-- Navegación interna -->
      <nav aria-label="Secciones de esta página" class="mt-8 max-w-5xl mx-auto">
        <ul class="flex flex-wrap justify-center gap-3">
          {
            sections.map((s) => (
              <li>
                <a
                  href={`#${s.id}`}
                  class="inline-block rounded-full border border-theme-border bg-theme-surface px-5 py-2 text-theme-text-secondary hover:text-theme-primary hover:border-theme-primary transition-colors"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
 
  <!-- 1. Información sobre consumos problemáticos -->
  <section
    id="informacion"
    class="section scroll-mt-24 bg-gradient-to-b from-theme-surface to-theme-surface-muted"
  >
    <div class="container">
      <div class="narrow mx-auto text-center space-y-6 mb-12">
        <Heading level="h2" align="center">
          Qué son los consumos problemáticos
        </Heading>
        <p class="text-lg lg:text-xl text-theme-text-secondary leading-relaxed">
          Hablamos de consumo problemático cuando el uso de una sustancia o una
          conducta empieza a afectar la salud, los vínculos, el estudio, el
          trabajo o la vida cotidiana. No depende solo de la cantidad ni de la
          frecuencia: importa cómo impacta en la persona y en su entorno.
        </p>
        <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
          Es un problema de salud, no una falta de voluntad ni un defecto de
          carácter. Tiene tratamiento, y las personas pueden recuperarse a
          cualquier edad y en cualquier momento.
        </p>
      </div>
 
      <div
        class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto mb-16"
      >
        {
          tiposDeConsumo.map((t) => (
            <div class="bg-theme-surface rounded-xl p-6 lg:p-8 shadow-md border border-theme-border">
              <h3 class="text-xl font-bold text-theme-text-primary mb-3">
                {t.title}
              </h3>
              <p class="text-theme-text-secondary leading-relaxed">
                {t.description}
              </p>
            </div>
          ))
        }
      </div>
 
      <div
        class="max-w-4xl mx-auto bg-gradient-to-br from-theme-primary-lighter/20 to-theme-surface rounded-xl p-6 lg:p-10 border border-theme-border"
      >
        <h3 class="text-2xl font-bold text-theme-text-primary mb-2">
          Señales de alerta
        </h3>
        <p class="text-theme-text-secondary mb-6">
          Ninguna señal alcanza por sí sola para dar un diagnóstico, pero si
          reconocés varias, vale la pena consultar.
        </p>
        <ul class="space-y-3">
          {senalesDeAlerta.map((s) => <CheckListItem>{s}</CheckListItem>)}
        </ul>
      </div>
    </div>
  </section>
 
  <!-- 2. Información para personas que necesitan ayuda -->
  <section
    id="ayuda"
    class="section scroll-mt-24 bg-gradient-to-b from-theme-surface-muted to-theme-surface"
  >
    <div class="container">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 items-center gap-12 lg:gap-16"
      >
        <div class="w-full order-2 lg:order-1">
          <Image
            src={professionalPortraitImage}
            alt="Profesional de la salud escuchando a una persona"
            class="w-full object-cover rounded-2xl shadow-xl"
          />
        </div>
        <div class="space-y-6 order-1 lg:order-2">
          <Heading level="h2">Si necesitás ayuda</Heading>
          <p
            class="text-base lg:text-lg text-theme-text-secondary leading-relaxed"
          >
            Si sentís que el consumo se te fue de las manos, o que te está
            haciendo daño, no estás solo ni sola. Pedir ayuda no te
            compromete a nada y no te define: es una forma de cuidarte.
          </p>
          <ol class="space-y-5">
            {
              pasosParaPedirAyuda.map((p, i) => (
                <li class="flex items-start gap-4">
                  <span
                    class="flex-shrink-0 w-9 h-9 rounded-full bg-theme-primary text-white font-bold flex items-center justify-center"
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  <div>
                    <h3 class="font-semibold text-theme-text-primary mb-1">
                      {p.title}
                    </h3>
                    <p class="text-theme-text-secondary">{p.description}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="text-theme-text-secondary">
            La consulta es confidencial. Si preferís empezar por teléfono,
            podés llamar al <a
              href="tel:141"
              class="font-semibold text-theme-primary underline">141</a
            > en cualquier momento.
          </p>
        </div>
      </div>
    </div>
  </section>
 
  <!-- 3. Información para familiares -->
  <section
    id="familias"
    class="section scroll-mt-24 bg-theme-surface"
  >
    <div class="container">
      <div class="narrow mx-auto text-center space-y-4 mb-12">
        <Heading level="h2" align="center">Para familiares y seres queridos</Heading>
        <p class="text-base lg:text-lg text-theme-text-secondary leading-relaxed">
          Cuando alguien cercano atraviesa un consumo problemático, toda la
          familia se ve afectada. Es normal sentir miedo, enojo, cansancio o
          culpa. Vos también podés pedir orientación y acompañamiento.
        </p>
      </div>
 
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        <div
          class="bg-gradient-to-br from-theme-primary-lighter/20 to-theme-surface rounded-xl p-6 lg:p-8 border border-theme-border"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 rounded-lg bg-theme-primary flex items-center justify-center flex-shrink-0"
            >
              <Icon name="check" size="lg" class="text-white" />
            </div>
            <h3 class="text-xl font-bold text-theme-text-primary">
              Qué te puede ayudar
            </h3>
          </div>
          <ul class="space-y-3">
            {paraFamilias.hacer.map((t) => <CheckListItem>{t}</CheckListItem>)}
          </ul>
        </div>
 
        <div
          class="bg-gradient-to-br from-[color:var(--color-theme-accent-orange)]/20 to-theme-surface rounded-xl p-6 lg:p-8 border border-theme-border"
        >
          <div class="flex items-center gap-3 mb-6">
            <div
              class="w-12 h-12 rounded-lg bg-[color:var(--color-theme-accent-orange)] flex items-center justify-center flex-shrink-0"
            >
              <Icon name="star" size="lg" class="text-white" />
            </div>
            <h3 class="text-xl font-bold text-theme-text-primary">
              Qué conviene evitar
            </h3>
          </div>
          <ul class="space-y-3">
            {paraFamilias.evitar.map((t) => <CheckListItem>{t}</CheckListItem>)}
          </ul>
        </div>
      </div>
 
      <div
        class="mt-12 max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 items-center gap-8 lg:gap-12"
      >
        <Image
          src={serviceDetailImage}
          alt="Familia conversando con un profesional"
          class="w-full object-cover rounded-2xl shadow-xl"
        />
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-theme-text-primary">
            No tenés que hacerlo solo ni sola
          </h3>
          <p class="text-theme-text-secondary leading-relaxed">
            Llamar al 141 también es una opción si la persona todavía no quiere
            pedir ayuda: un equipo profesional te orienta sobre cómo
            acercarte, qué decir y a dónde acudir. Cerca del 40% de las
            consultas a la línea las hacen familiares y amigos.
          </p>
          <p class="text-theme-text-secondary leading-relaxed">
            Cuidar tu propia salud y tus tiempos no es egoísmo: es parte de
            poder acompañar.
          </p>
        </div>
      </div>
    </div>
  </section>
 
  <!-- 4. Materiales de orientación -->
  <section
    id="materiales"
    class="section scroll-mt-24 bg-gradient-to-b from-theme-surface to-theme-surface-muted"
  >
    <div class="container">
      <div class="narrow mx-auto text-center space-y-4 mb-12">
        <Heading level="h2" align="center">Materiales de orientación</Heading>
        <p class="text-base lg:text-lg text-theme-text-secondary">
          Guías y recursos para leer, descargar y compartir.
        </p>
      </div>
 
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
        {
          materiales.map((m) => (
            <a
              href={m.href}
              class="group block bg-theme-surface rounded-xl p-6 lg:p-8 shadow-md border border-theme-border hover:border-theme-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-theme-primary transition-colors"
            >
              <span class="inline-block text-sm font-semibold text-theme-primary mb-2">
                {m.format}
              </span>
              <h3 class="text-xl font-bold text-theme-text-primary mb-2 group-hover:text-theme-primary">
                {m.title}
              </h3>
              <p class="text-theme-text-secondary leading-relaxed">
                {m.description}
              </p>
              <span class="inline-block mt-4 font-semibold text-theme-primary">
                Descargar
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CallToActionSection
    heading="Estamos para escucharte"
    subheading="Si necesitás orientación o querés conocer más sobre Regénesis, ponete en contacto con nosotros."
    primaryButtonText="Contactanos"
    primaryButtonLink="/contact"
    secondaryButtonText="Conocé nuestras actividades"
    secondaryButtonLink="/careers"
  />
</Layout>
