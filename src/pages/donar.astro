---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import CallToActionSection from "../components/CallToActionSection.astro";
import Icon from "../components/Icon.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { donacion, donacionEstado } from "../lib/donacion";
import { whatsappUrl } from "../lib/contacto";
import { acciones, type Accion } from "../lib/acciones";
import donarImage from "../assets/actividades/acompanamiento.jpg";

const { mercadoPago, transferencia, hayMetodo } = donacionEstado;

const alias = donacion.transferenciaAlias.trim();
const cvu = donacion.transferenciaCvu.trim();
const titular = donacion.transferenciaTitular.trim();

const metodosDisponibles = Number(mercadoPago) + Number(transferencia);
const datosDeEjemplo = donacion.datosDeEjemplo;

const whatsappColaborar = whatsappUrl(
  "Hola, quiero colaborar con Regénesis. ¿Me pueden contar cómo hacer una donación?",
);

const accionWhatsapp: Accion = {
  label: "Escribinos por WhatsApp",
  href: whatsappColaborar,
};

const accionFinal = hayMetodo ? accionWhatsapp : acciones.actividades;

const faqs = [
  ...(mercadoPago
    ? [
        {
          question: "¿Es seguro donar online?",
          answer:
            "Sí. Los pagos se realizan en Mercado Pago, que procesa la información de pago. En este sitio no se solicitan ni se guardan datos de tarjetas.",
        },
        {
          question: "¿Necesito tener Mercado Pago?",
          answer:
            "No. Podés pagar con los medios que ofrece Mercado Pago o elegir una transferencia directa si preferís.",
        },
      ]
    : []),
  ...(transferencia
    ? [
        {
          question: "¿Puedo hacer una transferencia?",
          answer:
            "Sí. Los datos de alias y CVU están en esta página. Si tenés dudas, escribinos por WhatsApp y te acompañamos.",
        },
        {
          question: "¿Cómo confirmo mi aporte?",
          answer: "Escribinos por WhatsApp con el comprobante y te confirmamos la recepción.",
        },
      ]
    : []),
  {
    question: "¿Puedo colaborar con otra cosa que no sea dinero?",
    answer:
      "Sí. También podés sumarte a las actividades, difundir nuestro trabajo o acercarte a conversar con el equipo. Escribinos y vemos cómo.",
  },
];

const faqStructuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const destinos = [
  {
    icon: "users" as const,
    title: "Talleres y encuentros",
    text: "Sostenemos los espacios terapéuticos, deportivos y comunitarios que forman parte del acompañamiento.",
  },
  {
    icon: "book" as const,
    title: "Materiales y recursos",
    text: "Producimos guías, recursos de orientación y materiales para las personas y sus familias.",
  },
  {
    icon: "heart" as const,
    title: "Acompañamiento cotidiano",
    text: "Colaboramos con las necesidades diarias que hacen posible recibir y acompañar a cada persona.",
  },
];
---

<Layout
  title="Donar | Regénesis"
  description="Colaborá con Regénesis. Conocé cómo donar por transferencia y cómo tu aporte sostiene los talleres, encuentros y el acompañamiento."
  structuredData={faqStructuredData}
>
  <PageHero
    title="Tu aporte sostiene la comunidad"
    description="Las donaciones nos permiten sostener los talleres, los encuentros y el acompañamiento cotidiano de las personas que se acercan a Regénesis. Cada aporte, grande o pequeño, ayuda a que el proceso de recuperación sea posible."
    image={donarImage}
    imageAlt="Personas participando de un encuentro de Regénesis"
  />

  <section class="section bg-theme-surface">
    <div class="container">
      <SectionHeading
        align="center"
        eyebrow="Cómo colaborar"
        title="Elegí la opción que te resulte más simple"
        description={
          hayMetodo
            ? "Estas son las opciones disponibles para colaborar. Si tenés dudas, escribinos y te acompañamos."
            : "Estamos terminando de habilitar las donaciones online. Mientras tanto, escribinos y coordinamos una transferencia u otra forma de colaborar."
        }
        class="mb-10"
      />

      {datosDeEjemplo && (
        <div
          class="mx-auto mb-8 flex max-w-3xl items-start gap-3 rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm leading-relaxed text-amber-900 dark:border-amber-700 dark:bg-amber-900/20 dark:text-amber-100"
          role="note"
        >
          <Icon name="info" size="md" class="mt-0.5 shrink-0" />
          <p>
            <strong class="font-semibold">Datos de ejemplo.</strong> Los datos de transferencia
            todavía no están confirmados. Si querés colaborar ahora,{" "}
            <a
              href={whatsappColaborar}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold underline"
            >
              escribinos por WhatsApp
              <span class="sr-only"> (se abre en una nueva pestaña)</span>
            </a>{" "}
            y lo coordinamos.
          </p>
        </div>
      )}

      {hayMetodo ? (
        <div
          class:list={[
            "grid grid-cols-1 gap-6",
            metodosDisponibles === 1 && "mx-auto max-w-md",
            metodosDisponibles === 2 && "mx-auto max-w-3xl md:grid-cols-2",
          ]}
        >
          {mercadoPago && (
            <article class="card flex h-full flex-col p-6">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-theme-primary-lighter/20">
                <Icon name="heart" size="lg" class="text-theme-primary" />
              </div>
              <h3 class="text-xl font-bold text-theme-text-primary">Donación única</h3>
              <p class="mt-2 flex-1 text-theme-text-secondary">
                Elegí el monto que quieras aportar. El pago se procesa de forma segura en Mercado
                Pago.
              </p>
              <div class="mt-6">
                <Button
                  href={donacion.mercadoPagoUrl}
                  showIcon={true}
                  class="w-full justify-center"
                >
                  Donar con Mercado Pago
                </Button>
                <p class="mt-3 text-xs leading-relaxed text-theme-text-muted">
                  Vas a ser redirigido a Mercado Pago. No almacenamos datos de tarjetas.
                </p>
              </div>
            </article>
          )}

          {transferencia && (
            <article class="card flex h-full flex-col p-6">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-theme-primary-lighter/20">
                <Icon name="clipboard" size="lg" class="text-theme-primary" />
              </div>
              <h3 class="text-xl font-bold text-theme-text-primary">Transferencia</h3>
              <p class="mt-2 flex-1 text-theme-text-secondary">
                Si preferís transferir directamente, podés hacerlo con los siguientes datos.
              </p>
              <dl class="mt-6 space-y-4">
                {alias && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-theme-text-muted">
                      Alias
                    </dt>
                    <dd class="mt-1 flex flex-wrap items-center justify-between gap-2">
                      <span class="break-all font-semibold text-theme-text-primary">{alias}</span>
                      <button
                        type="button"
                        data-copy-value={alias}
                        data-copy-label="Alias"
                        aria-label={`Copiar el alias ${alias}`}
                        class="inline-flex items-center gap-1.5 rounded-full border border-theme-border px-3 py-1 text-xs font-semibold text-theme-primary transition-colors hover:border-theme-primary"
                      >
                        <Icon name="clipboard" size="sm" />
                        Copiar
                      </button>
                    </dd>
                  </div>
                )}
                {cvu && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-theme-text-muted">
                      CVU
                    </dt>
                    <dd class="mt-1 flex flex-wrap items-center justify-between gap-2">
                      <span class="break-all font-semibold text-theme-text-primary">{cvu}</span>
                      <button
                        type="button"
                        data-copy-value={cvu}
                        data-copy-label="CVU"
                        aria-label={`Copiar el CVU ${cvu}`}
                        class="inline-flex items-center gap-1.5 rounded-full border border-theme-border px-3 py-1 text-xs font-semibold text-theme-primary transition-colors hover:border-theme-primary"
                      >
                        <Icon name="clipboard" size="sm" />
                        Copiar
                      </button>
                    </dd>
                  </div>
                )}
                {titular && (
                  <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-theme-text-muted">
                      Titular
                    </dt>
                    <dd class="mt-1 font-semibold text-theme-text-primary">{titular}</dd>
                  </div>
                )}
              </dl>
              <p class="mt-4 text-sm text-theme-text-secondary">
                Si tenés dudas,{" "}
                <a
                  href={whatsappColaborar}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-semibold text-theme-primary hover:underline"
                >
                  escribinos por WhatsApp
                  <span class="sr-only"> (se abre en una nueva pestaña)</span>
                </a>
                {"."}
              </p>
            </article>
          )}
        </div>
      ) : (
        <div class="card mx-auto max-w-2xl p-8 text-center">
          <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-theme-primary-lighter/20">
            <Icon name="heart" size="xl" class="text-theme-primary" />
          </div>
          <h3 class="text-xl font-bold text-theme-text-primary">
            Estamos habilitando las donaciones online
          </h3>
          <p class="mt-3 text-theme-text-secondary">
            Pronto vas a poder donar con Mercado Pago. Mientras tanto, escribinos y coordinamos una
            transferencia u otra forma de colaborar.
          </p>
          <Button href={whatsappColaborar} class="mt-6">
            Escribinos por WhatsApp
          </Button>
        </div>
      )}

      <p
        id="copy-status"
        class="mt-4 text-center text-sm font-medium text-theme-primary"
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </section>

  <section class="section bg-gradient-to-b from-theme-surface-muted to-theme-surface">
    <div class="container">
      <SectionHeading
        align="center"
        eyebrow="Transparencia"
        title="¿A dónde va tu aporte?"
        description="Tu colaboración se destina al funcionamiento cotidiano de Regénesis y a sostener los espacios de acompañamiento."
        class="mb-10"
      />

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {destinos.map((destino) => (
          <article class="card p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-theme-primary-lighter/20">
              <Icon name={destino.icon} size="lg" class="text-theme-primary" />
            </div>
            <h3 class="text-xl font-bold text-theme-text-primary">{destino.title}</h3>
            <p class="mt-2 text-theme-text-secondary">{destino.text}</p>
          </article>
        ))}
      </div>

      <div class="mx-auto mt-10 flex max-w-3xl items-start gap-4 rounded-2xl border border-theme-border bg-theme-surface p-5">
        <Icon name="info" size="lg" class="mt-0.5 shrink-0 text-theme-primary" />
        <p class="text-theme-text-secondary">
          {mercadoPago
            ? "Los pagos online se procesan en Mercado Pago. Regénesis no recibe ni almacena datos de tarjetas. Si necesitás una constancia o querés coordinar una donación de otra forma, escribinos y lo vemos juntos."
            : "Las transferencias se hacen desde el home banking o la app de tu banco. Si necesitás una constancia o querés coordinar la donación de otra forma, escribinos y lo vemos juntos."}
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-theme-surface">
    <div class="container">
      <div class="narrow mx-auto">
        <SectionHeading align="center" title="Preguntas frecuentes" class="mb-8" />

        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-theme-border bg-theme-surface p-5">
              <summary class="cursor-pointer font-semibold text-theme-text-primary">
                {faq.question}
              </summary>
              <p class="mt-3 text-theme-text-secondary">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CallToActionSection
    heading={hayMetodo ? "¿Querés colaborar de otra forma?" : "Conocé otras formas de acompañar"}
    subheading={
      hayMetodo
        ? "Escribinos y te contamos cómo sumarte a las actividades, difundir el proyecto o acompañar desde tu lugar."
        : "Mientras habilitamos las donaciones online, podés sumarte a nuestras actividades y conocer el proyecto."
    }
    primaryAction={accionFinal}
  />
</Layout>

<script>
  const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy-value]");
  const copyStatus = document.getElementById("copy-status");

  copyButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copyValue ?? "";
      const label = button.dataset.copyLabel ?? "Dato";

      try {
        await navigator.clipboard.writeText(value);
        if (copyStatus) copyStatus.textContent = `${label} copiado.`;
      } catch {
        if (copyStatus) copyStatus.textContent = `No pudimos copiar el ${label.toLowerCase()}.`;
      }
    });
  });
</script>
