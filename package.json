{
  "name": "regenesis-sitio-web",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "private": true,
  "description": "Sitio web institucional de Regénesis, asociación civil de Rosario dedicada al acompañamiento de personas que atraviesan situaciones de consumo problemático y a sus familias.",
  "keywords": [
    "regenesis",
    "astro",
    "ong",
    "adicciones",
    "consumos-problematicos",
    "rosario",
    "tailwind",
    "typescript",
    "pages-cms"
  ],
  "author": {
    "name": "Regénesis"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaraEOlivera/propuesta-regenesis.git"
  },
  "homepage": "https://saraeolivera.github.io/propuesta-regenesis/",
  "engines": {
    "node": ">=22.23.4"
  },
  "files": [
    "src",
    "public",
    "astro.config.mjs",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "test": "npm run build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "prepublishOnly": "npm test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2"
  }
}
